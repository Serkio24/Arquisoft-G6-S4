# Copiar este archivo como .env para desarrollo local
# NUNCA subir el .env real al repositorio

# URL de SonarQube (local: docker-compose, producción: EC2 interno)
SONAR_URL=http://localhost:9000

# Token de autenticación — generarlo en SonarQube UI:
# My Account > Security > Generate Token
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave del proyecto en SonarQube
SONAR_PROJECT_KEY=SprintArq4
